# Agent keys — loaded from this file at run time
OPENAI_API_KEY=
CURSOR_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Codex / judge may use OpenAI; some setups use OpenRouter.
OPENROUTER_API_KEY=

# Blaxel (default sandbox). `bl login` also works instead of these.
BL_WORKSPACE=
BL_API_KEY=

# Optional. Verifier LLM-judge model (task.toml default is gpt-5.6-luna).
JUDGE_MODEL=
